LISTEN_HOST=127.0.0.1
LISTEN_PORT=8443
ENABLE_CLAMAV=true
ENABLE_IMUNIFYAV=false
ENABLE_PHP_MALWARE_SCANNER=true
ENABLE_PHP_MALWARE_SCANNER_SIGNATURE_REVISION=b9e5824
PHP_MALWARE_SCANNER_SCRIPT=/opt/mama-imunify/php-malware-scanner/scan.php
CLAMAV_ENGINE_VERSION=1.4.3
CLAMAV_SIGNATURE_REVISION=28157
SCAN_TMP_ROOT=/run/mama-imunify/requests
SCAN_EVENT_ROOT=/run/mama-imunify/events
TLS_CERT_FILE=/etc/mama-imunify/tls/server.crt
TLS_KEY_FILE=/etc/mama-imunify/tls/server.key
TLS_CLIENT_CA_FILE=/etc/mama-imunify/tls/client-ca.crt
